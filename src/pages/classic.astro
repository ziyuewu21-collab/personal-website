---
// One page, laid out as a CELTA lesson plan: each section is a stage (see data/lesson.ts),
// and the LessonHud bar tracks where you are. Section ids must match the stage ids.
import Base from "../layouts/Base.astro";
import Avatar from "../components/Avatar.astro";
import HeroIcon from "../components/HeroIcon.astro";
import Scribble from "../components/Scribble.astro";
import SectionHead from "../components/SectionHead.astro";
import Classroom from "../components/Classroom.astro";
import ReportCard from "../components/ReportCard.astro";
import PairLearning from "../components/PairLearning.astro";
import ChatContact from "../components/ChatContact.astro";
import { site } from "../data/site";
import { projects, research } from "../data/projects";
import { celta, principles } from "../data/teaching";

const heroLines = [
  { href: "#teaching", icon: "board", text: "taught in the classroom," },
  { href: "#research", icon: "flask", text: "tested in the lab, and" },
  { href: "#projects", icon: "phone", text: "shipped to real learners." },
] as const;

const elsewhere = [
  { label: "LinkedIn", href: site.linkedin },
  { label: "Substack", href: site.substack },
  { label: "GitHub", href: site.github },
].filter((l) => l.href);
---

<Base title="Ziyue Wu — the classic view">
  <!-- Stage 01 · Lead-in -->
  <section id="top" class="mx-auto w-full max-w-[1100px] px-4 pt-14 pb-20 md:pt-20 md:pb-28">
    <h1 class="mono text-(--color-ink-soft)">{site.name} · Product manager for language learning</h1>
    <p class="hero mt-20 max-w-[23ch] text-[30px] leading-[1.35] font-semibold tracking-tight md:text-[52px]">
      I'm Ziyue.
      <Avatar inline lines={site.heroLines} class="hero-avatar mx-1" />
      I&nbsp;design language&#8209;learning products from what&nbsp;I've
      {
        heroLines.map((l) => (
          <a href={l.href} class="hero-line">
            <HeroIcon kind={l.icon} />
            <span>{l.text}</span>
          </a>
        ))
      }
    </p>
    <p class="mt-8 max-w-[52ch] text-lg text-(--color-ink-soft)">
      UCL speech science, CELTA teacher training and a shipped edtech product.
      I build for how people actually learn to communicate:{" "}
      <Scribble kind="mark">with other people</Scribble>.
    </p>
    <div class="mt-10 flex flex-wrap items-start gap-6">
      <div class="aim max-w-[26rem] border-l-2 border-(--color-ink) pl-4">
        <p class="mono text-(--color-accent)">Lesson aim</p>
        <p class="mt-1">{site.lessonAim}</p>
      </div>
      {
        site.cvReady && (
          <a href="/cv.pdf" class="btn btn-ghost">
            Download CV
          </a>
        )
      }
    </div>
  </section>

  <!-- Stage 02 · Context -->
  <section id="projects" class="scroll-mt-6 border-t border-(--color-line)">
    <div class="mx-auto w-full max-w-[1100px] px-4 py-16 md:py-20">
      <SectionHead stage="projects" title="What I've shipped">
        <p>Three products, from a government tender to my own app.</p>
      </SectionHead>
      <ol class="mt-10">
        {
          projects.map((p, i) => (
            <li class="project grid gap-6 border-t border-(--color-line) py-10 md:grid-cols-[1fr_1.15fr] md:gap-12">
              <div>
                <p class="mono text-(--color-ink-soft)">
                  {String(i + 1).padStart(2, "0")} · {p.status === "building" ? "Building now" : "Shipped"}
                </p>
                <h3 class="mt-3 text-2xl tracking-tight md:text-[28px]">{p.title}</h3>
                <p class="mt-3 text-sm text-(--color-ink-soft)">{p.role}</p>
                <p class="mono mt-4 text-(--color-ink-soft)">{p.tags.join(" · ")}</p>
              </div>
              <div>
                <p>{p.description}</p>
                <p class="mt-4 font-semibold">{p.result}</p>
                {p.links && p.links.length > 0 && (
                  <ul class="mt-6 flex flex-wrap gap-3">
                    {p.links.map((l, k) => (
                      <li>
                        <a href={l.url} class:list={["btn", k === 0 ? "btn-primary" : "btn-ghost"]} rel="noopener" target="_blank">
                          {l.label} ↗
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Stage 03 · Task -->
  <section id="teaching" class="scroll-mt-6 border-t border-(--color-line) bg-(--color-paper-alt)">
    <div class="mx-auto w-full max-w-[1100px] px-4 py-16 md:py-20">
      <SectionHead stage="teaching" title="How I teach">
        <p>
          {celta.course} at {celta.centre}, {celta.dates}: {celta.hours}, with
          {" "}{celta.modes.toLowerCase()}. Overall grade
          {" "}<strong class="text-(--color-ink)">{celta.grade}</strong>, {celta.gradeNote}.
        </p>
      </SectionHead>

      <div class="mt-10 grid items-start gap-10 lg:grid-cols-[1.35fr_0.65fr]">
        <Classroom />
        <div class="lg:pt-16">
          <p class="text-xl font-semibold tracking-tight">
            My best lessons run on <s class="text-(--color-ink-soft)">me talking</s> my students talking.
          </p>
          <p class="mt-4">
            Flip the classroom. When it's student-centred, the learners do most
            of the talking, and my job moves from explaining to{" "}
            <Scribble kind="mark">designing the task</Scribble>, monitoring and
            giving feedback.
          </p>
          <p class="mt-3 text-(--color-ink-soft)">
            It's the same job I do as a PM: set up the conditions, then watch
            what people actually do.
          </p>
        </div>
      </div>

      <h3 class="mt-20 text-2xl tracking-tight">Classroom habits I build products with</h3>
      <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {
          principles.map((p) => (
            <article class="sketch flex flex-col p-5">
              <svg viewBox="0 0 48 48" class="boil h-10 w-10" aria-hidden="true">
                <g fill="none" stroke="var(--color-ink)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  {p.icon === "ear" && (
                    <>
                      <path d="M16 20 C 16 10, 34 8, 34 20 C 34 28, 26 30, 26 36 C 26 42, 18 42, 17 37" fill="var(--color-skin)" />
                      <path d="M22 20 C 22 16, 28 16, 28 20 C 28 23, 24 24, 24 27" />
                      <path d="M38 14 C 41 18, 41 24, 38 28 M42 10 C 47 17, 47 25, 42 32" stroke="var(--color-accent)" />
                    </>
                  )}
                  {p.icon === "question" && (
                    <>
                      <path d="M8 10 C 20 6, 36 6, 42 10 C 44 18, 44 26, 40 30 C 32 32, 24 32, 18 31 L 10 40 L 12 30 C 6 26, 6 16, 8 10 Z" fill="var(--color-highlight)" />
                      <path d="M20 16 C 20 11, 30 11, 30 16 C 30 20, 25 20, 25 24" />
                      <circle cx="25" cy="27.5" r="0.8" fill="var(--color-ink)" />
                    </>
                  )}
                  {p.icon === "steps" && (
                    <>
                      <path d="M6 40 L 18 40 L 18 30 L 28 30 L 28 20 L 38 20 L 38 10 L 44 10" />
                      <circle cx="12" cy="34" r="3" fill="var(--color-accent)" stroke="none" />
                    </>
                  )}
                  {p.icon === "flag" && (
                    <>
                      <path d="M12 42 L 12 6" />
                      <path d="M12 8 C 20 4, 26 12, 38 8 L 38 24 C 26 28, 20 20, 12 24 Z" fill="var(--color-highlight)" />
                    </>
                  )}
                </g>
              </svg>
              <h4 class="mt-4 text-lg font-semibold tracking-tight">{p.habit}</h4>
              <p class="mt-2 text-sm text-(--color-ink-soft)">{p.classroom}</p>
              <p class="mono mt-5 text-(--color-accent)">→ In product</p>
              <p class="mt-1 text-sm font-semibold">{p.product}</p>
            </article>
          ))
        }
      </div>

      <div class="mt-16">
        <ReportCard />
      </div>
    </div>
  </section>

  <!-- Stage 04 · Language focus -->
  <section id="research" class="scroll-mt-6 border-t border-(--color-line)">
    <div class="mx-auto w-full max-w-[1100px] px-4 py-16 md:py-20">
      <SectionHead stage="research" title="Why learning is social">
        <p>
          I study how people learn new words from each other: the questions, the
          gestures, the looking back and forth. I use that science to make product
          decisions, not papers for their own sake.
        </p>
      </SectionHead>
      <div class="mt-10 grid items-start gap-10 lg:grid-cols-[1.2fr_0.8fr]">
        <PairLearning />
        <div class="divide-y divide-(--color-line) lg:pt-14">
          {
            research.map((r) => (
              <article class="py-5 first:pt-0">
                <p>{r.finding}</p>
                <p class="mt-3 font-semibold text-(--color-accent)">→ {r.takeaway}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Stage 05 · Feedback -->
  <section id="contact" class="scroll-mt-6 border-t border-(--color-line) bg-(--color-paper-alt)">
    <div class="mx-auto grid w-full max-w-[1100px] gap-10 px-4 py-16 md:py-20 lg:grid-cols-[0.8fr_1.2fr]">
      <SectionHead stage="contact" title="Your turn to talk">
        <p>
          Looking for a PM who has taught the learner, studied the science, and
          shipped the product? Tell me here, or email {site.email}.
        </p>
        <p class="mt-4">
          I also write in public about building AI products for language learning.
        </p>
        <ul class="mt-4 flex flex-wrap gap-x-6 font-semibold">
          {
            elsewhere.map((l) => (
              <li>
                <a href={l.href} class="inline-block py-3 text-(--color-ink) hover:text-(--color-accent)" rel="noopener">
                  {l.label} ↗
                </a>
              </li>
            ))
          }
        </ul>
      </SectionHead>
      <ChatContact />
    </div>
  </section>
</Base>

<style>
  .hero {
    text-wrap: pretty;
  }
  .hero :global(.hero-avatar) {
    width: 3.2em;
    margin-bottom: -0.1em;
  }
  @media (max-width: 640px) {
    .hero :global(.hero-avatar) {
      width: 2.7em;
    }
  }
  .hero-line {
    display: flex;
    align-items: center;
    gap: 0.45em;
    width: fit-content;
    margin-top: 0.15em;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
    transition: text-decoration-color 200ms ease;
  }
  .hero-line:first-of-type {
    margin-top: 0.3em;
  }
  .hero-line:hover {
    text-decoration-color: var(--color-accent);
  }
  .hero-line:hover :global(.hero-icon) {
    transform: rotate(-8deg) scale(1.1);
  }
</style>
