---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found — Ziyue Wu" hud={false}>
  <section class="mx-auto w-full max-w-[1100px] px-4 py-24">
    <h1 class="text-[32px]">Page not found</h1>
    <p class="mt-4 text-(--color-ink-soft)">
      That page doesn't exist.
    </p>
    <a
      href="/"
      class="btn btn-primary mt-8"
    >
      Back to home
    </a>
  </section>
</Base>
