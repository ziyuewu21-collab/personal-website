---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found — Ziyue Wu">
  <section class="mx-auto w-full max-w-[1100px] px-4 py-24">
    <h1 class="text-[32px]">Page not found</h1>
    <p class="mt-4 text-(--color-ink-soft)">
      That page doesn't exist.
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded-[6px] bg-(--color-accent) px-6 py-3 font-semibold text-white hover:opacity-90"
    >
      Back to home
    </a>
  </section>
</Base>
