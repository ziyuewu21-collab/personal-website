---
// Homepage: Ziyue's Desk. A desktop with files to open, a lesson-plan sticky note that
// ticks off as you go, and Ziyue as the guide, giving one instruction at a time.
// The long scrolling page lives on at /classic. Copy: src/data/desk.ts.
import Base from "../layouts/Base.astro";
import InkField from "../components/desk/InkField.astro";
import DeskIcon from "../components/desk/DeskIcon.astro";
import Window from "../components/desk/Window.astro";
import Guide from "../components/desk/Guide.astro";
import MoonishGame from "../components/desk/MoonishGame.astro";
import GrammarAuction from "../components/desk/GrammarAuction.astro";
import GuessWord from "../components/desk/GuessWord.astro";
import HeyDoodle from "../components/desk/HeyDoodle.astro";
import LearnersExplainer from "../components/LearnersExplainer.astro";
import { aboutMe } from "../data/learning";
import Classroom from "../components/Classroom.astro";
import ReportCard from "../components/ReportCard.astro";
import PairLearning from "../components/PairLearning.astro";
import StoryDemo from "../components/StoryDemo.astro";
import ChatContact from "../components/ChatContact.astro";
import { site } from "../data/site";
import { projects, research } from "../data/projects";
import { celta, principles } from "../data/teaching";
import { items, plan, answerKey, trash, education, games } from "../data/desk";

const [myturn] = projects;
const profiles = [
  { label: "LinkedIn", href: site.linkedin },
  { label: "Substack", href: site.substack },
  { label: "GitHub", href: site.github },
].filter((l) => l.href);
---

<Base bare>
  <InkField />

  <div class="desk">
    <nav class="menubar" aria-label="Desk menu">
      <a href="/" class="hand logo">Ziyue's Desk</a>
      <button type="button" class="menu-item" data-tour-btn>Tour</button>
      <button type="button" class="menu-item" data-open="resume">Resume</button>
      <a href="/classic" class="menu-item">Classic view</a>
      <span class="mono clock" data-clock aria-label="Time in London">London --:--</span>
    </nav>

    <div class="wallpaper">
      <p class="mono text-(--color-ink-soft)">You found my desk</p>
      <h1 class="mt-2 text-[40px] leading-none font-semibold tracking-tight md:text-[64px]">{site.name}</h1>
      <p class="mt-3 text-lg font-semibold md:text-xl">Product manager for language learning</p>
      <p class="mono mt-2 text-(--color-ink-soft)">UCL speech science · CELTA {celta.grade} · shipped edtech</p>
    </div>

    <div class="hey">
      <HeyDoodle />
    </div>

    <ul class="icons" aria-label="Files on the desk">
      {
        items.map((it) => (
          <li class:list={["icon-slot", `slot-${it.id}`, it.loose && "is-loose"]}>
            <button type="button" class="desk-icon" data-open={it.id}>
              <DeskIcon kind={it.icon} />
              <span class="desk-label">{it.label}</span>
            </button>
          </li>
        ))
      }
    </ul>

    <aside class="note" aria-labelledby="plan-title">
      <p id="plan-title" class="hand note-title">
        {plan.title} <span class="mono note-min">{plan.minutes}</span>
      </p>
      <ol class="note-rows">
        {
          plan.rows.map((r, i) => (
            <li>
              <button type="button" class="note-row" data-open={r.id} data-plan-row={r.id}>
                <span class="tick" aria-hidden="true">
                  <svg viewBox="0 0 20 20"><path d="M4 10.5 L8.5 15 L16 5" /></svg>
                </span>
                <span class="mono note-n">{String(i + 1).padStart(2, "0")}</span>
                <span>{r.label}</span>
                <span class="sr-only" data-done-sr></span>
              </button>
            </li>
          ))
        }
      </ol>
      <p class="hand note-aim">{plan.aim}</p>
    </aside>
    <p class="classic-link"><a href="/classic">Prefer scrolling? Classic view →</a></p>
  </div>

  <noscript>
    <p class="noscript">This desk needs JavaScript. <a href="/classic">Read the classic version →</a></p>
  </noscript>

  <!-- Windows -->
  <Window id="myturn" width="min(620px, 92vw)">
    <p class="mono text-(--color-ink-soft)">Shipped · {myturn.tags.join(" · ")}</p>
    <h3 class="mt-2 text-2xl tracking-tight">{myturn.title}</h3>
    <p class="mt-2 text-sm text-(--color-ink-soft)">{myturn.role}</p>
    <p class="mt-4">{myturn.description}</p>
    <p class="mt-4 font-semibold">{myturn.result}</p>
    <ul class="mt-5 flex flex-wrap gap-3">
      {
        myturn.links?.map((l, k) => (
          <li>
            <a href={l.url} class:list={["btn", k === 0 ? "btn-primary" : "btn-ghost"]} rel="noopener" target="_blank">
              {l.label} ↗
            </a>
          </li>
        ))
      }
    </ul>
  </Window>

  <Window id="work" width="min(720px, 92vw)">
    <ol class="divide-y divide-(--color-line)">
      {
        projects.map((p, i) => (
          <li class="py-5 first:pt-0">
            <p class="mono text-(--color-ink-soft)">{String(i + 1).padStart(2, "0")} · {p.tags.join(" · ")}</p>
            <h3 class="mt-2 text-xl tracking-tight">{p.title}</h3>
            <p class="mt-1 text-sm text-(--color-ink-soft)">{p.role}</p>
            <p class="mt-3 text-sm">{p.description}</p>
            <p class="mt-3 text-sm font-semibold">{p.result}</p>
            {p.demo && (
              <button type="button" class="btn btn-primary mt-4" data-open={p.demo.id}>
                {p.demo.label} →
              </button>
            )}
            {p.links && p.links.length > 0 && (
              <ul class="mt-3 flex flex-wrap gap-x-5 text-sm font-semibold">
                {p.links.map((l) => (
                  <li>
                    <a href={l.url} class="inline-block py-2 underline underline-offset-4 hover:text-(--color-accent)" rel="noopener" target="_blank">
                      {l.label} ↗
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
  </Window>

  <Window id="storydemo" width="min(860px, 94vw)">
    <StoryDemo />
  </Window>

  <Window id="classroom" width="min(920px, 94vw)">
    <p class="text-(--color-ink-soft)">
      {celta.course} at {celta.centre}, {celta.dates}: {celta.hours}, with {celta.modes.toLowerCase()}.
      Overall grade <strong class="text-(--color-ink)">{celta.grade}</strong>, {celta.gradeNote}.
    </p>
    <p class="mt-4 text-xl font-semibold tracking-tight">
      My best lessons run on <s class="text-(--color-ink-soft)">me talking</s> my students talking.
    </p>
    <div class="mt-6">
      <Classroom />
    </div>
    <h3 class="mt-10 text-xl tracking-tight">Classroom habits I build products with</h3>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      {
        principles.map((p) => (
          <article class="sketch p-4">
            <h4 class="font-semibold">{p.habit}</h4>
            <p class="mt-1 text-sm text-(--color-ink-soft)">{p.classroom}</p>
            <p class="mono mt-3 text-(--color-accent)">→ In product</p>
            <p class="mt-1 text-sm font-semibold">{p.product}</p>
          </article>
        ))
      }
    </div>
    <div class="mt-10">
      <ReportCard />
    </div>
  </Window>

  <Window id="lab" width="min(860px, 94vw)">
    <LearnersExplainer />
    <h3 class="mt-12 text-xl tracking-tight">Ingredient 2, in one picture</h3>
    <p class="mt-1 text-(--color-ink-soft)">
      I study how people learn new words from each other: the questions, the gestures, the
      looking back and forth. Flip the learner's role:
    </p>
    <div class="mt-4">
      <PairLearning />
    </div>
    <div class="mt-8 divide-y divide-(--color-line)">
      {
        research.map((r) => (
          <article class="py-4 first:pt-0">
            <p>{r.finding}</p>
            <p class="mt-2 font-semibold text-(--color-accent)">→ {r.takeaway}</p>
          </article>
        ))
      }
    </div>
    <button type="button" class="btn btn-ghost mt-6" data-open="game">Try it: Moonish →</button>
  </Window>

  <Window id="games" width="min(520px, 92vw)">
    <p class="text-(--color-ink-soft)">Three 30-second games. Each one is a technique from my CELTA classroom.</p>
    <ul class="mt-4 divide-y divide-(--color-line)">
      {
        games.map((g) => (
          <li class="flex items-center justify-between gap-4 py-4">
            <div>
              <p class="font-semibold">{g.name}</p>
              <p class="mt-1 text-sm text-(--color-ink-soft)">{g.blurb}</p>
            </div>
            <button type="button" class="btn btn-primary shrink-0" data-open={g.id}>Play</button>
          </li>
        ))
      }
    </ul>
  </Window>

  <Window id="guess" width="min(560px, 92vw)">
    <GuessWord />
  </Window>

  <Window id="auction" width="min(580px, 92vw)">
    <GrammarAuction />
  </Window>

  <Window id="resume" width="min(680px, 92vw)">
    <header class="border-b border-(--color-line) pb-4">
      <h3 class="text-2xl tracking-tight">{site.name}</h3>
      <p class="mt-1 font-semibold">Product manager for language learning</p>
      <p class="mt-2 text-sm text-(--color-ink-soft)">
        <a href={`mailto:${site.email}`} class="underline underline-offset-4">{site.email}</a>
        {profiles.map((l) => (
          <>
            {" · "}
            <a href={l.href} class="underline underline-offset-4" rel="noopener" target="_blank">{l.label}</a>
          </>
        ))}
      </p>
    </header>
    <h4 class="mono mt-5 text-(--color-accent)">Experience</h4>
    <ul class="mt-2 space-y-4">
      {
        projects.map((p) => (
          <li>
            <p class="font-semibold">{p.title}</p>
            <p class="text-sm text-(--color-ink-soft)">{p.role}</p>
            <p class="mt-1 text-sm">{p.result}</p>
          </li>
        ))
      }
    </ul>
    <h4 class="mono mt-6 text-(--color-accent)">Education & training</h4>
    <ul class="mt-2 space-y-3">
      {
        education.map((e) => (
          <li>
            <p class="font-semibold">{e.what}</p>
            <p class="text-sm text-(--color-ink-soft)">{e.where}</p>
            <p class="mt-1 text-sm">{e.note}</p>
          </li>
        ))
      }
      <li>
        <p class="font-semibold">{celta.course} · {celta.grade}</p>
        <p class="text-sm text-(--color-ink-soft)">{celta.centre}</p>
        <p class="mt-1 text-sm">{celta.dates} · {celta.hours}</p>
      </li>
    </ul>
    <div class="mt-6 flex flex-wrap items-center gap-3 border-t border-(--color-line) pt-5">
      {
        site.cvReady ? (
          <a href="/cv.pdf" class="btn btn-primary" target="_blank">Download PDF ↗</a>
        ) : (
          <a href={`mailto:${site.email}?subject=${encodeURIComponent("CV request")}`} class="btn btn-primary">Email me for the PDF</a>
        )
      }
      <a href="/classic" class="btn btn-ghost">Prefer scrolling? Classic view</a>
    </div>
  </Window>

  <Window id="chat" width="min(520px, 92vw)">
    <ChatContact />
  </Window>

  <Window id="game" width="min(560px, 92vw)">
    <MoonishGame />
  </Window>

  <Window id="about" width="min(560px, 92vw)">
    <p class="hand text-4xl leading-none" lang="zh">{aboutMe.heading}</p>
    <p class="mt-4 text-lg font-semibold tracking-tight">{aboutMe.intro}</p>
    <dl class="mt-4 divide-y divide-(--color-line)">
      {
        aboutMe.rows.map((r) => (
          <div class="py-3">
            <dt class="mono text-(--color-accent)">{r.q}</dt>
            <dd class="mt-1">{r.a}</dd>
          </div>
        ))
      }
    </dl>
  </Window>

  <Window id="answers" width="min(440px, 92vw)">
    <p class="hand text-5xl">{answerKey.big}</p>
    {answerKey.lines.map((l) => <p class="mt-3">{l}</p>)}
  </Window>

  <Window id="trash" width="min(480px, 92vw)">
    <ul class="divide-y divide-(--color-line)">
      {
        trash.map((t) => (
          <li class="py-3 first:pt-0">
            <p class="mono text-(--color-ink)">{t.file}</p>
            <p class="mt-1 text-sm text-(--color-ink-soft)">{t.note}</p>
          </li>
        ))
      }
    </ul>
  </Window>

  <Guide />
</Base>

<style>
  .desk {
    position: relative;
    z-index: 1;
    height: 100dvh;
    min-height: 560px;
    overflow: hidden;
  }

  /* menu bar */
  .menubar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 200;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    height: 44px;
    padding: 0 0.75rem;
    border-bottom: 1.5px solid var(--color-ink);
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(8px);
    font-size: 0.875rem;
  }
  .logo {
    margin-right: 0.75rem;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
  }
  .menu-item {
    padding: 0.4rem 0.6rem;
    border-radius: 6px;
  }
  .menu-item:hover {
    background: var(--color-cardigan);
  }
  .clock {
    margin-left: auto;
    color: var(--color-ink-soft);
  }

  /* wallpaper text */
  .wallpaper {
    position: absolute;
    left: 6%;
    bottom: 9%;
    max-width: 34rem;
    pointer-events: none;
  }

  /* icons */
  .icons {
    position: absolute;
    top: 68px;
    left: 24px;
    display: grid;
    grid-template-columns: repeat(3, 112px);
    grid-auto-rows: 112px;
  }
  .icon-slot {
    display: flex;
    justify-content: center;
  }
  /* the secret file and the trash sit apart from the grid */
  .slot-answers {
    position: fixed;
    left: calc(24px + 336px + 6vw);
    top: 46vh;
  }
  .slot-trash {
    position: fixed;
    right: calc(4% + 300px);
    top: 72px;
  }
  .desk-icon {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    width: 104px;
    padding: 0.5rem 0.25rem;
    border-radius: 12px;
  }
  .desk-icon :global(.desk-icon-art) {
    transition: transform 180ms cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .desk-icon:hover :global(.desk-icon-art) {
    transform: translateY(-3px) rotate(-4deg);
  }
  .desk-label {
    padding: 0.05rem 0.45rem;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.85);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .desk-icon[aria-expanded="true"] .desk-label,
  .desk-icon:focus-visible .desk-label {
    background: var(--color-ink);
    color: #fff;
  }
  /* "open me next": a little hop, a dashed ring, a handwritten nudge */
  .desk-icon:global(.is-next) {
    animation: hop 1.4s ease-in-out infinite;
  }
  .desk-icon:global(.is-next)::before {
    content: "";
    position: absolute;
    inset: -6px 6px 18px;
    border: 2px dashed var(--color-cardigan-dark);
    border-radius: 999px;
    z-index: -1;
    background: rgb(246 201 69 / 0.25);
  }
  .desk-icon:global(.is-next)::after {
    content: "here!";
    position: absolute;
    top: -18px;
    right: -10px;
    font-family: var(--font-hand);
    font-size: 1.35rem;
    color: var(--color-ink);
    rotate: 10deg;
  }
  @keyframes hop {
    0%, 100% { transform: translateY(0); }
    40% { transform: translateY(-7px); }
  }
  /* the secret file sits at an angle, begging to be opened */
  .slot-answers .desk-icon {
    rotate: -8deg;
  }

  /* sticky note */
  .note {
    position: absolute;
    top: 76px;
    right: 4%;
    width: 280px;
    padding: 1.1rem 1.1rem 1rem;
    background: var(--color-cardigan);
    box-shadow: 0 10px 30px rgb(31 29 26 / 0.14), 0 1.5px 0 var(--color-ink);
    rotate: -1.5deg;
  }
  .note::before {
    content: "";
    position: absolute;
    top: -10px;
    left: 50%;
    width: 84px;
    height: 22px;
    translate: -50% 0;
    rotate: 3deg;
    background: rgb(255 255 255 / 0.7);
    border: 1px solid rgb(31 29 26 / 0.12);
  }
  .note-title {
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.1;
  }
  .note-min {
    margin-left: 0.25rem;
    font-size: 0.65rem;
    vertical-align: middle;
  }
  .note-rows {
    margin-top: 0.6rem;
  }
  .note-row {
    display: grid;
    grid-template-columns: 22px 22px 1fr;
    align-items: center;
    gap: 0.45rem;
    width: 100%;
    min-height: 40px;
    padding: 0.2rem 0.3rem;
    border-radius: 6px;
    text-align: left;
    font-weight: 600;
  }
  .note-row:hover {
    background: rgb(255 255 255 / 0.45);
  }
  .note-row:global(.is-next) {
    background: rgb(255 255 255 / 0.6);
  }
  .note-n {
    font-size: 0.65rem;
  }
  .tick {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border: 1.5px solid var(--color-ink);
    border-radius: 4px;
    background: rgb(255 255 255 / 0.6);
  }
  .tick svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 20;
    stroke-dashoffset: 20;
    transition: stroke-dashoffset 400ms ease;
  }
  .note-row:global(.is-done) .tick svg {
    stroke-dashoffset: 0;
  }
  .note-aim {
    margin-top: 0.6rem;
    font-size: 1.15rem;
    line-height: 1.2;
  }

  .classic-link {
    display: none;
  }

  /* HEYTEA-style doodle on the wallpaper; only where there's room for it */
  .hey {
    position: absolute;
    left: 45%;
    bottom: 3%;
    width: min(22vw, 300px);
    pointer-events: none;
    display: none;
  }
  @media (min-width: 1200px) {
    .hey {
      display: block;
    }
  }

  .noscript {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 300;
    padding: 1rem;
    background: var(--color-ink);
    color: #fff;
    text-align: center;
  }

  /* Phones: the desk becomes a home screen that scrolls. */
  @media (max-width: 767px) {
    .desk {
      height: auto;
      min-height: 100dvh;
      overflow: visible;
      padding: 64px 16px 150px;
    }
    .menubar .menu-item[href] {
      display: none;
    }
    .logo {
      font-size: 1.3rem;
      margin-right: auto;
    }
    .clock {
      display: none;
    }
    .wallpaper {
      position: static;
    }
    .hey {
      position: static;
      display: block;
      width: 240px;
      margin: 1.25rem auto 0;
    }
    .icons {
      position: static;
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: auto;
      gap: 0.75rem 0.25rem;
      margin-top: 1.75rem;
    }
    .slot-answers,
    .slot-trash {
      position: static;
    }
    .slot-answers .desk-icon {
      rotate: -4deg;
    }
    .note {
      position: relative;
      inset: auto;
      width: auto;
      margin-top: 2rem;
      rotate: -0.5deg;
    }
    .classic-link {
      display: block;
      margin-top: 1.5rem;
      text-align: center;
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }
  :global(html.win-open) {
    overflow: hidden;
  }
</style>

<script>
  // The desk's window manager: open, focus, drag, close, and tick the lesson plan.
  const KEY = "ziyue-desk";
  const load = (): { opened?: string[] } => {
    try {
      return JSON.parse(localStorage.getItem(KEY) || "{}");
    } catch {
      return {};
    }
  };
  const save = (patch: object) => {
    try {
      localStorage.setItem(KEY, JSON.stringify({ ...load(), ...patch }));
    } catch {
      /* private mode: progress isn't remembered */
    }
  };

  const wins = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>("[data-win]").forEach((w) => wins.set(w.dataset.win!, w));
  const openers = new Map<string, HTMLElement | null>();
  const opened = new Set<string>(load().opened ?? []);
  const isPhone = () => matchMedia("(max-width: 767px)").matches;
  let z = 20;
  let cascade = 0;

  const tick = () => {
    document.querySelectorAll<HTMLElement>("[data-plan-row]").forEach((row) => {
      const done = opened.has(row.dataset.planRow!);
      row.classList.toggle("is-done", done);
      row.querySelector("[data-done-sr]")!.textContent = done ? " (done)" : "";
    });
  };
  const syncScrollLock = () => {
    const any = [...wins.values()].some((w) => !w.hidden);
    document.documentElement.classList.toggle("win-open", any && isPhone());
  };
  const front = (w: HTMLElement) => {
    w.style.zIndex = String(++z);
  };
  const place = (w: HTMLElement) => {
    if (isPhone() || w.dataset.placed) return;
    const rect = w.getBoundingClientRect();
    const left = Math.max(12, (innerWidth - rect.width) / 2 - 120 + cascade * 28);
    const top = Math.max(56, Math.min(84 + cascade * 24, innerHeight - rect.height - 12));
    w.style.left = `${left}px`;
    w.style.top = `${top}px`;
    w.dataset.placed = "1";
    cascade = (cascade + 1) % 5;
  };

  const open = (id: string, opener: HTMLElement | null = null) => {
    const w = wins.get(id);
    if (!w) return;
    openers.set(id, opener);
    w.hidden = false;
    place(w);
    front(w);
    document.querySelectorAll(`[data-open="${id}"]`).forEach((b) => b.setAttribute("aria-expanded", "true"));
    w.querySelector<HTMLElement>(".win-title")?.focus({ preventScroll: true });
    opened.add(id);
    save({ opened: [...opened] });
    tick();
    syncScrollLock();
    window.dispatchEvent(new CustomEvent("desk:open", { detail: { id } }));
  };
  const close = (id: string) => {
    const w = wins.get(id);
    if (!w || w.hidden) return;
    w.hidden = true;
    document.querySelectorAll(`[data-open="${id}"]`).forEach((b) => b.setAttribute("aria-expanded", "false"));
    openers.get(id)?.focus({ preventScroll: true });
    syncScrollLock();
    window.dispatchEvent(new CustomEvent("desk:close", { detail: { id } }));
  };

  document.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    const opener = t.closest<HTMLElement>("[data-open]");
    if (opener) {
      open(opener.dataset.open!, opener);
      return;
    }
    const closer = t.closest<HTMLElement>("[data-close]");
    if (closer) close(closer.closest<HTMLElement>("[data-win]")!.dataset.win!);
  });
  document.querySelectorAll("[data-tour-btn]").forEach((b) =>
    b.addEventListener("click", () => window.dispatchEvent(new CustomEvent("desk:tour"))),
  );
  window.addEventListener("desk:request", (e) => open((e as CustomEvent).detail.id));

  // Click anywhere in a window to bring it forward.
  wins.forEach((w) => w.addEventListener("pointerdown", () => front(w)));

  // Esc closes the window on top.
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const top = [...wins.values()].filter((w) => !w.hidden).sort((a, b) => Number(b.style.zIndex) - Number(a.style.zIndex))[0];
    if (top) close(top.dataset.win!);
  });

  // Drag windows by their title bar (not on phones, where they're full-screen sheets).
  wins.forEach((w) => {
    const bar = w.querySelector<HTMLElement>("[data-drag]")!;
    bar.addEventListener("pointerdown", (e) => {
      if (isPhone() || (e.target as HTMLElement).closest("button")) return;
      const r = w.getBoundingClientRect();
      const dx = e.clientX - r.left;
      const dy = e.clientY - r.top;
      bar.setPointerCapture(e.pointerId);
      w.classList.add("is-dragging");
      const move = (ev: PointerEvent) => {
        const left = Math.min(innerWidth - 80, Math.max(80 - r.width, ev.clientX - dx));
        const top = Math.min(innerHeight - 40, Math.max(44, ev.clientY - dy));
        w.style.left = `${left}px`;
        w.style.top = `${top}px`;
      };
      const up = () => {
        w.classList.remove("is-dragging");
        bar.removeEventListener("pointermove", move);
        bar.removeEventListener("pointerup", up);
        bar.removeEventListener("pointercancel", up);
      };
      bar.addEventListener("pointermove", move);
      bar.addEventListener("pointerup", up);
      bar.addEventListener("pointercancel", up);
    });
  });

  // London clock in the menu bar.
  const clock = document.querySelector<HTMLElement>("[data-clock]");
  const fmt = new Intl.DateTimeFormat("en-GB", { timeZone: "Europe/London", hour: "2-digit", minute: "2-digit" });
  const tickClock = () => {
    if (clock) clock.textContent = `London ${fmt.format(new Date())}`;
  };
  tickClock();
  setInterval(tickClock, 20_000);

  document.querySelectorAll("[data-open]").forEach((b) => b.setAttribute("aria-expanded", "false"));
  tick();
</script>
