---
// Ziyue's portrait for the chat: her winking illustration, or the laughing one.
interface Props {
  class?: string;
  mood?: "wink" | "laugh";
}
const { class: className = "", mood = "wink" } = Astro.props;
---

<img src={`/avatar/${mood}-160.webp`} class:list={["rounded-full", className]} width="160" height="160" alt="" decoding="async" loading="lazy" />
