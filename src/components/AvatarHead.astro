---
// Just the head from Avatar.astro, static. Used next to chat messages.
// Keep the paths in step with Avatar.astro if her look changes.
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg viewBox="62 52 176 176" class={className} aria-hidden="true">
  <g stroke="var(--color-ink)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="150" cy="140" r="86" fill="var(--color-paper-alt)" stroke="none" />
    <path d="M150 60 C 98 58, 70 98, 72 150 C 73 190, 66 228, 76 262 L 224 262 C 234 228, 227 190, 228 150 C 230 98, 202 62, 150 60 Z" fill="var(--color-hair)" />
    <path d="M150 76 C 186 75, 211 103, 210 142 C 209 181, 185 208, 150 208 C 115 208, 90 182, 90 142 C 90 103, 114 77, 150 76 Z" fill="var(--color-skin)" />
    <path d="M92 120 C 80 168, 78 232, 74 292 L 106 298 C 110 268, 114 238, 108 212 C 100 194, 93 172, 93 148 Z" fill="var(--color-hair)" />
    <path d="M208 120 C 220 168, 222 232, 226 292 L 194 298 C 190 268, 186 238, 192 212 C 200 194, 207 172, 207 148 Z" fill="var(--color-hair)" />
    <path d="M88 150 C 84 96, 112 62, 152 62 C 190 62, 216 96, 212 150 C 206 126, 196 106, 182 96 C 170 90, 162 88, 156 82 C 148 90, 136 94, 122 99 C 106 107, 94 126, 88 150 Z" fill="var(--color-hair)" />
    <circle cx="127" cy="154" r="7" fill="var(--color-ink)" stroke="none" />
    <circle cx="173" cy="154" r="7" fill="var(--color-ink)" stroke="none" />
    <g fill="none" stroke="var(--color-frame)" stroke-width="4">
      <path d="M106 140 L148 140 L146 162 C 145 167, 141 170, 136 170 L 116 170 C 111 170, 108 167, 107 162 Z" />
      <path d="M152 140 L194 140 L193 162 C 192 167, 189 170, 184 170 L 164 170 C 159 170, 155 167, 154 162 Z" />
      <path d="M148 143 Q150 140 152 143" />
    </g>
    <ellipse cx="111" cy="182" rx="10" ry="6" fill="var(--color-blush)" stroke="none" opacity="0.7" />
    <ellipse cx="189" cy="182" rx="10" ry="6" fill="var(--color-blush)" stroke="none" opacity="0.7" />
    <path d="M134 184 Q150 199 166 184" fill="none" />
  </g>
</svg>
