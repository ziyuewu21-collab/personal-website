---
// Ziyue's avatar: her own illustration (the yellow-cardigan wink), with the laughing
// one swapped in for reactions. She leans toward the pointer (a soft 3D tilt), bounces
// hello, and a click makes her laugh and say the next line. All instances share one
// script. Images: public/avatar/{wink,laugh}-{160,512}.webp.
// inline: sits inside a sentence (hero); her bubble pops above her and fades out.
// quiet: no bubble of her own (the desk guide does the talking); a click fires an
// "avatar:poke" event the guide listens for. Any script can fire "avatar:laugh" on window.
interface Props {
  lines?: string[];
  class?: string;
  bubble?: "left" | "right";
  inline?: boolean;
  quiet?: boolean;
}
const { lines = [], class: className = "", bubble = "left", inline = false, quiet = false } = Astro.props;
const src = (mood: "wink" | "laugh") => ({
  src: `/avatar/${mood}-512.webp`,
  srcset: `/avatar/${mood}-160.webp 160w, /avatar/${mood}-512.webp 512w`,
});
---

<span
  class:list={["avatar relative select-none", inline ? "avatar-inline inline-block align-bottom" : "block", className]}
  data-avatar
  data-lines={JSON.stringify(lines)}
  data-autohide={inline ? "" : undefined}
>
  {
    !quiet && (
      <span
        class:list={[
          "bubble hand sketch absolute z-10 block px-4 py-2 text-xl leading-tight font-normal tracking-normal md:text-2xl",
          inline ? "bubble-top" : `bubble-${bubble}`,
        ]}
        data-bubble
        aria-live="polite"
      >
        {inline ? "" : lines[0]}
      </span>
    )
  }
  <button type="button" class="av-btn block w-full cursor-pointer rounded-full" aria-label="Say hi to Ziyue. Each click, she says something new.">
    <span class="av-tilt block">
      <img class="av-img av-wink" {...src("wink")} sizes="(max-width: 767px) 120px, 260px" width="512" height="512" alt="" decoding="async" />
      <img class="av-img av-laugh" {...src("laugh")} sizes="(max-width: 767px) 120px, 260px" width="512" height="512" alt="" decoding="async" />
    </span>
  </button>
</span>

<style>
  .bubble {
    width: max-content;
    max-width: 15rem;
    transform-origin: bottom center;
  }
  .bubble-left {
    top: -14%;
    left: -10%;
  }
  .bubble-right {
    top: -14%;
    right: -10%;
  }
  /* little tail pointing down at her */
  .bubble::after {
    content: "";
    position: absolute;
    bottom: -8px;
    width: 14px;
    height: 14px;
    background: #fff;
    border-right: 1.5px solid var(--color-ink);
    border-bottom: 1.5px solid var(--color-ink);
    transform: rotate(45deg) skew(8deg, 8deg);
  }
  .bubble-left::after {
    right: 28%;
  }
  .bubble-right::after {
    left: 28%;
  }
  .bubble-top {
    bottom: 100%;
    left: 50%;
    translate: -50% -6px;
    opacity: 0;
    scale: 0.6;
    transition: opacity 180ms ease, scale 260ms cubic-bezier(0.34, 1.56, 0.64, 1);
    pointer-events: none;
  }
  .bubble-top::after {
    left: calc(50% - 7px);
  }
  .bubble-top.show {
    opacity: 1;
    scale: 1;
  }
  .bubble.pop:not(.bubble-top) {
    animation: pop 260ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes pop {
    from { transform: scale(0.6) rotate(-4deg); opacity: 0; }
    to { transform: scale(1) rotate(0); opacity: 1; }
  }

  .av-tilt {
    position: relative;
    aspect-ratio: 1;
    transform: perspective(700px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) translate(var(--tx, 0px), var(--ty, 0px));
    transition: transform 220ms ease-out, scale 200ms ease;
    animation: breathe 4.5s ease-in-out infinite;
  }
  @keyframes breathe {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -3px; }
  }
  .av-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 999px;
    filter: drop-shadow(0 8px 14px rgb(31 29 26 / 0.14));
    transition: opacity 140ms ease;
  }
  .av-laugh {
    opacity: 0;
  }
  .is-laughing .av-laugh {
    opacity: 1;
  }
  .is-laughing .av-wink {
    opacity: 0;
  }
  .av-btn:hover .av-tilt {
    scale: 1.04;
  }
  .is-bouncing .av-btn {
    animation: bounce 0.6s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  @keyframes bounce {
    0% { transform: translateY(0) scale(1); }
    30% { transform: translateY(-10px) scale(1.04, 0.97); }
    60% { transform: translateY(0) scale(0.98, 1.03); }
    100% { transform: translateY(0) scale(1); }
  }
  .is-laughing .av-btn {
    animation: giggle 0.3s ease-in-out 4;
  }
  @keyframes giggle {
    0%, 100% { transform: rotate(0deg); }
    50% { transform: rotate(-3deg) translateY(-2px); }
  }
</style>

<script>
  const avatars = [...document.querySelectorAll<HTMLElement>("[data-avatar]")];
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // --- lean toward the pointer ---
  let frame = 0;
  const lean = (x: number, y: number) => {
    for (const a of avatars) {
      const tilt = a.querySelector<HTMLElement>(".av-tilt")!;
      const r = tilt.getBoundingClientRect();
      const dx = x - (r.left + r.width / 2);
      const dy = y - (r.top + r.height / 2);
      const reach = Math.max(innerWidth, innerHeight) / 2;
      const nx = Math.max(-1, Math.min(1, dx / reach));
      const ny = Math.max(-1, Math.min(1, dy / reach));
      tilt.style.setProperty("--ry", `${(nx * 14).toFixed(2)}deg`);
      tilt.style.setProperty("--rx", `${(-ny * 10).toFixed(2)}deg`);
      tilt.style.setProperty("--tx", `${(nx * 5).toFixed(1)}px`);
      tilt.style.setProperty("--ty", `${(ny * 4).toFixed(1)}px`);
    }
  };
  if (!reduceMotion) {
    window.addEventListener(
      "pointermove",
      (e) => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => lean(e.clientX, e.clientY));
      },
      { passive: true },
    );
  }

  // --- reactions ---
  function bounce(a: HTMLElement) {
    if (reduceMotion) return;
    a.classList.remove("is-bouncing");
    void a.offsetWidth; // restart the animation
    a.classList.add("is-bouncing");
    setTimeout(() => a.classList.remove("is-bouncing"), 650);
  }
  function laugh(a: HTMLElement, ms = 1500) {
    a.classList.add("is-laughing");
    clearTimeout(Number(a.dataset.laughTimer));
    a.dataset.laughTimer = String(setTimeout(() => a.classList.remove("is-laughing"), ms));
  }
  window.addEventListener("avatar:laugh", () => avatars.forEach((a) => laugh(a)));

  const say = new Map<HTMLElement, (i: number) => void>();
  for (const a of avatars) {
    const lines: string[] = JSON.parse(a.dataset.lines || "[]");
    const bubble = a.querySelector<HTMLElement>("[data-bubble]");
    const autohide = a.dataset.autohide !== undefined;
    let i = 0;
    let hideTimer = 0;
    const speak = (n: number) => {
      if (!bubble || !lines.length) return;
      bubble.textContent = lines[n];
      bubble.classList.remove("pop");
      void bubble.offsetWidth;
      bubble.classList.add("pop", "show");
      if (autohide) {
        clearTimeout(hideTimer);
        hideTimer = window.setTimeout(() => bubble.classList.remove("show"), 4000);
      }
    };
    say.set(a, speak);
    a.querySelector("button")!.addEventListener("click", () => {
      if (lines.length) i = (i + 1) % lines.length;
      speak(i);
      laugh(a, 1100);
      a.dispatchEvent(new CustomEvent("avatar:poke", { bubbles: true }));
    });
  }

  // Bounce hello once when each avatar first comes into view; inline ones say line one.
  const hello = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const a = e.target as HTMLElement;
        hello.unobserve(a);
        setTimeout(() => {
          bounce(a);
          if (a.dataset.autohide !== undefined) say.get(a)?.(0);
        }, 400);
      }
    },
    { threshold: 0.5 },
  );
  avatars.forEach((a) => hello.observe(a));
</script>
