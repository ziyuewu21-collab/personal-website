---
// Section heading: lesson-stage kicker ("Stage 03 · Task · Ss ↔ Ss") over the h2,
// plus optional intro text. Stage data: src/data/lesson.ts.
import { stages } from "../data/lesson";

interface Props {
  stage: string; // section id, e.g. "teaching"
  title: string;
}
const { stage, title } = Astro.props;
const s = stages.find((x) => x.id === stage);
---

<div>
  {
    s && (
      <p class="mono text-(--color-accent)">
        Stage {s.n} · {s.name} · <span class="normal-case">{s.interaction}</span>
      </p>
    )
  }
  <h2 class="mt-3 text-[28px] tracking-tight md:text-[40px]">{title}</h2>
  <div class="mt-4 max-w-[65ch] text-(--color-ink-soft)">
    <slot />
  </div>
</div>
