---
// Desk wallpaper: a quiet field of letters from many languages. Near the pointer they
// swell, darken and drift away, then settle back. Canvas 2D, redraws only while
// something is moving, pauses in hidden tabs, and stays still for reduced motion.
---

<canvas class="ink-field" aria-hidden="true" data-ink></canvas>

<style>
  .ink-field {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>("[data-ink]");
  const ctx = canvas?.getContext("2d");
  if (canvas && ctx) {
    const glyphs = ["a", "文", "あ", "ü", "é", "한", "ñ", "字", "?", "ß", "ç", "语", "!", "ö", "z", "ا", "ж", "ω"];
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const ink = getComputedStyle(document.documentElement).getPropertyValue("--color-ink").trim() || "#1f1d1a";
    const font = getComputedStyle(document.documentElement).getPropertyValue("--font-hand").trim() || "cursive";
    const GAP = 44;
    const RADIUS = 150;

    type Cell = { x: number; y: number; g: string; dx: number; dy: number; s: number; r: number; base: number };
    let cells: Cell[] = [];
    let w = 0;
    let h = 0;
    let dpr = 1;
    const pointer = { x: -9999, y: -9999 };
    let raf = 0;

    const build = () => {
      dpr = Math.min(2, window.devicePixelRatio || 1);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cells = [];
      let k = 0;
      for (let y = GAP / 2; y < h + GAP; y += GAP) {
        for (let x = GAP / 2; x < w + GAP; x += GAP) {
          // a little jitter so it reads as hand-placed, not a grid
          const j = Math.sin(k * 12.9898) * 43758.5453;
          const rnd = j - Math.floor(j);
          cells.push({
            x: x + (rnd - 0.5) * 10,
            y: y + ((rnd * 7) % 1 - 0.5) * 10,
            g: glyphs[Math.floor(rnd * glyphs.length)],
            dx: 0,
            dy: 0,
            s: 1,
            r: (rnd - 0.5) * 0.5,
            base: 0.045 + rnd * 0.04,
          });
          k++;
        }
      }
    };

    // One frame: ease every glyph toward its target; report whether anything still moves.
    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = ink;
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      let moving = false;
      for (const c of cells) {
        const vx = c.x - pointer.x;
        const vy = c.y - pointer.y;
        const d = Math.hypot(vx, vy);
        const t = d < RADIUS ? 1 - d / RADIUS : 0;
        const push = t * t * 22;
        const tx = d > 0 ? (vx / d) * push : 0;
        const ty = d > 0 ? (vy / d) * push : 0;
        const ts = 1 + t * 1.1;
        c.dx += (tx - c.dx) * 0.18;
        c.dy += (ty - c.dy) * 0.18;
        c.s += (ts - c.s) * 0.18;
        if (Math.abs(tx - c.dx) > 0.05 || Math.abs(ts - c.s) > 0.005) moving = true;
        const alpha = c.base + (c.s - 1) * 0.6;
        ctx.globalAlpha = Math.min(0.85, alpha);
        ctx.save();
        ctx.translate(c.x + c.dx, c.y + c.dy);
        ctx.rotate(c.r * c.s);
        ctx.font = `${Math.round(17 * c.s)}px ${font}`;
        ctx.fillText(c.g, 0, 0);
        ctx.restore();
      }
      ctx.globalAlpha = 1;
      return moving;
    };

    const loop = () => {
      const moving = draw();
      raf = moving && !document.hidden ? requestAnimationFrame(loop) : 0;
    };
    const kick = () => {
      if (!raf && !reduce) raf = requestAnimationFrame(loop);
    };

    const onMove = (e: PointerEvent) => {
      pointer.x = e.clientX;
      pointer.y = e.clientY;
      kick();
    };
    window.addEventListener("pointermove", onMove, { passive: true });
    window.addEventListener("pointerdown", onMove, { passive: true });
    document.addEventListener("pointerleave", () => {
      pointer.x = pointer.y = -9999;
      kick();
    });
    window.addEventListener("resize", () => {
      build();
      draw();
    });
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) kick();
    });

    build();
    draw();
    // Redraw once fonts are ready so the handwriting face is used.
    document.fonts?.ready.then(() => draw());
  }
</script>
