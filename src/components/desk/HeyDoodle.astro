---
// Desk wallpaper doodle, HEYTEA-style line art: two people on a paper-cup telephone,
// joined by a curly string. "hey!" one end, "你好!" the other. Learning happens between people.
import { curlPath } from "../../lib/curl";

const string = curlPath([176, 128], [300, 8], [404, 62], 9, 7);
---

<svg viewBox="0 0 520 270" class="hey-doodle" aria-hidden="true">
  <g fill="none" stroke="var(--color-ink)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
    <!-- the string -->
    <path class="hey-string" d={string} stroke-width="3" pathLength="1" />
    <!-- left: big, close, talking into the cup -->
    <path d="M44 270 C 46 222, 64 196, 96 190 C 130 194, 150 222, 152 270" fill="#fff" />
    <circle cx="96" cy="148" r="36" fill="#fff" />
    <path d="M62 140 C 62 116, 84 108, 104 112 C 126 116, 132 134, 130 146 C 116 140, 100 128, 92 118 C 84 130, 74 138, 62 140 Z" fill="var(--color-ink)" />
    <path d="M100 150 Q 108 156 116 150" />
    <path d="M116 168 Q 122 172 128 168" />
    <path d="M128 214 C 140 196, 148 170, 152 150" />
    <path d="M140 116 L 176 110 L 180 146 L 146 146 Z" fill="var(--color-cardigan)" />
    <!-- right: small, far away, listening -->
    <circle cx="452" cy="46" r="18" fill="#fff" />
    <path d="M434 40 C 436 26, 456 22, 468 32 C 462 36, 452 36, 442 34 Z" fill="var(--color-ink)" />
    <path d="M440 50 Q 444 46 448 50" />
    <path d="M436 62 Q 440 66 446 64" />
    <path d="M452 66 L 456 150 M 456 150 L 446 196 M 456 150 L 468 194" />
    <path d="M454 84 C 440 80, 426 72, 418 64" />
    <path d="M404 50 L 420 46 L 424 70 L 408 72 Z" fill="#fff" />
  </g>
  <text class="hand hey-hey" x="206" y="70" font-size="30" fill="var(--color-ink)" transform="rotate(-28 206 70)">hey!</text>
  <text class="hey-ni" x="360" y="108" font-size="20" fill="var(--color-ink)" lang="zh">你好!</text>
</svg>

<style>
  .hey-doodle {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .hey-string {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: hey-draw 2.4s cubic-bezier(0.6, 0, 0.3, 1) 0.6s forwards;
  }
  @keyframes hey-draw {
    to { stroke-dashoffset: 0; }
  }
  .hey-hey, .hey-ni {
    opacity: 0;
    animation: hey-pop 0.4s ease forwards;
  }
  .hey-hey { animation-delay: 1.2s; }
  .hey-ni { animation-delay: 2.8s; }
  @keyframes hey-pop {
    from { opacity: 0; translate: 0 6px; }
    to { opacity: 1; translate: 0 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hey-string { stroke-dashoffset: 0; animation: none; }
    .hey-hey, .hey-ni { opacity: 1; animation: none; }
  }
</style>
