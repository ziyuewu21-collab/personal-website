---
import { site } from "../data/site";

// data-nav: LessonHud.astro marks the link for the section you're in (aria-current).
const nav = [
  { label: "work", href: "#projects" },
  { label: "teaching", href: "#teaching" },
  { label: "research", href: "#research" },
  { label: "contact", href: "#contact" },
];
---

<header class="mx-auto w-full max-w-[1100px] px-4 pt-6 pb-2 md:pt-8">
  <nav class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1" aria-label="Main">
    <a href="/" class="hand text-[30px] leading-none font-bold">{site.name}</a>
    <ul class="flex flex-wrap items-center gap-x-5 text-[15px] text-(--color-ink-soft) md:gap-x-7">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class="nav-link inline-block py-3 hover:text-(--color-ink)" data-nav>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .nav-link {
    position: relative;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    height: 1.5px;
    background: var(--color-ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms ease;
  }
  .nav-link[aria-current]::after {
    transform: scaleX(1);
  }
  .nav-link[aria-current] {
    color: var(--color-ink);
  }
</style>
